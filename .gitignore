# Secrets. Keys and tokens come from the environment, never from files in the repo.
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
keystore/
secrets/

# Foundry broadcast logs can hold RPC URLs with keys; publish deployments/xlayer.json instead.
broadcast/
cache/

# Local agent state and private host details. Never published.
.izie/
.claude/

# Planning files are internal and live outside this folder. Guard against copies.
PLAN.md
AGENTS.md
HACKATHON_RESEARCH.md
TAX_REVIEW_BRIEF.md
OPERATIONS.md
VERSIONS.local.md

# Build output and dependencies
# Solidity libraries are fetched at a pinned commit by contracts/scripts/fetch-deps.sh.
contracts/lib/
node_modules/
dist/
out/
coverage/
.venv/
__pycache__/
*.pyc

# Solver scratch. Published proof records live in docs/proofs/.
*.aig.tmp
work/

# Editor and OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Design working notes stay local. Only the brand kit (brand/) goes in Git.
docs/design/

# The product film build is internal. Only finished brand files go in Git.
brand/film/
